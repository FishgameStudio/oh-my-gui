/* Light Mode - Base */
* {
    background-color: #f5f5f5;
    color: #111111;
    border: none;
    font-family: Arial;
}

/* Button */
QPushButton {
    background-color: #e0e0e0;
    padding: 6px 12px;
    border-radius: 4px;
}
QPushButton:hover {
    background-color: #d0d0d0;
}
QPushButton:pressed {
    background-color: #c0c0c0;
}

/* RadioButton */
QRadioButton::indicator {
    background-color: #ffffff;
    border: 1px solid #999;
    border-radius: 8px;
    width: 14px;
    height: 14px;
}
QRadioButton::indicator:checked {
    background-color: #333;
    border: 2px solid #666;
}

/* ComboBox */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    padding: 4px;
    border-radius: 4px;
}
QComboBox::drop-down {
    border: none;
}
QComboBox::down-arrow {
    background-color: #555;
    width: 8px;
    height: 8px;
}

/* Slider */
QSlider::groove:horizontal {
    background: #ddd;
    height: 6px;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #444;
    width: 16px;
    height: 16px;
    border-radius: 8px;
}

/* ProgressBar */
QProgressBar {
    background-color: #e0e0e0;
    color: #111;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #555;
    border-radius: 4px;
}

/* TextEdit & ListWidget & Table */
QTextEdit, QListWidget, QTableWidget {
    background-color: #ffffff;
    color: #111111;
    border: 1px solid #ccc;
}
QListWidget::item:selected {
    background-color: #c0d8f0;
    color: #000;
}
QTableWidget::item:selected {
    background-color: #c0d8f0;
    color: #000;
}